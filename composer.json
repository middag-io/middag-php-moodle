{
  "name": "middag-io/moodle",
  "description": "MIDDAG Moodle adapter — platform bindings, ACL layer, and Moodle-specific implementations for middag-framework",
  "type": "library",
  "license": "Apache-2.0",
  "keywords": [
    "moodle",
    "adapter",
    "host-adapter",
    "mform",
    "xmldb",
    "inertia",
    "middag",
    "plugin"
  ],
  "homepage": "https://github.com/middag-io/middag-php-moodle",
  "support": {
    "issues": "https://github.com/middag-io/middag-php-moodle/issues",
    "source": "https://github.com/middag-io/middag-php-moodle",
    "security": "https://github.com/middag-io/middag-php-moodle/security/policy"
  },
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "middag-io/framework": "^2.0.0-rc.1",
    "middag-io/ui": "^2.0.0-rc.1",
    "nyholm/psr7": "^1.8",
    "psr/container": "^2.0",
    "psr/http-client": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0",
    "symfony/dependency-injection": "^7.4 || ^8.1",
    "symfony/event-dispatcher-contracts": "^3.0",
    "symfony/http-client": "^7.4 || ^8.1",
    "symfony/http-client-contracts": "^3.0",
    "symfony/http-foundation": "^7.4 || ^8.1",
    "symfony/messenger": "^7.4 || ^8.1",
    "symfony/psr-http-message-bridge": "^7.4 || ^8.1",
    "symfony/routing": "^7.4 || ^8.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "michaelmeneses/moodle-stubs": "~5.3.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^11.0",
    "rector/rector": "2.8.4"
  },
  "autoload": {
    "psr-4": {
      "Middag\\Moodle\\": "src/"
    },
    "exclude-from-classmap": [
      "/tests/phpstan/",
      "/tests/stubs/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Middag\\Moodle\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "post-install-cmd": "git config core.hooksPath .githooks 2>/dev/null || true",
    "post-update-cmd": "git config core.hooksPath .githooks 2>/dev/null || true",
    "check": [
      "@check:style",
      "@check:rector",
      "@check:stan"
    ],
    "check:style": "php-cs-fixer fix --dry-run --verbose --config=.php-cs-fixer.dist.php",
    "check:rector": "rector process --dry-run --config=.php-rector.php",
    "check:stan": "phpstan analyse --configuration=.phpstan.neon --memory-limit=512M",
    "check:stan:ceiling": "phpstan analyse --configuration=.phpstan-ceiling.neon --memory-limit=512M",
    "check:lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 -P4 php -l > /dev/null && php -l .php-cs-fixer.dist.php > /dev/null && php -l .php-rector.php > /dev/null",
    "fix": [
      "@fix:style",
      "@fix:rector"
    ],
    "fix:all": [
      "@fix:style",
      "@fix:rector",
      "@fix:style"
    ],
    "fix:style": "php-cs-fixer fix --verbose --show-progress=none --config=.php-cs-fixer.dist.php",
    "fix:rector": "rector process --config=.php-rector.php --no-progress-bar",
    "test": [
      "@test:unit",
      "@test:no-host"
    ],
    "test:unit": "phpunit",
    "test:cov": "XDEBUG_MODE=coverage phpunit --coverage-text",
    "test:no-host": "phpunit --configuration=phpunit.no-host.xml",
    "test:no-host:cov": "XDEBUG_MODE=coverage phpunit --configuration=phpunit.no-host.xml --coverage-text",
    "lint:php83": "bin/lint-php83.sh"
  }
}
